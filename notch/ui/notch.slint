import { Button } from "std-widgets.slint";

export struct PeerItem {
    alias: string,
    device_type: string,
    ip: string,
    port: int,
}

export struct StagedFile {
    name: string,
    size_formatted: string,
    ext_tag: string,
}

export component NotchWindow inherits Window {
    title: "MAX Notch — Vista Previa";
    no-frame: false; // Ventana normal para previsualizar de inmediato en Windows
    background: #09090C;
    width: 480px;
    height: 250px;

    in-out property <bool> is-expanded: true;
    in-out property <bool> is-hovered: false;
    in-out property <bool> is-transferring: false;
    in-out property <float> transfer-progress: 0.0;
    in-out property <string> transfer-speed: "0.0 MB/s";
    in-out property <string> active-peer-name: "Pixel 8 Pro (LocalSend)";
    in-out property <int> peer-count: 3;
    in-out property <int> selected-peer-index: 0;
    in-out property <[PeerItem]> peers: [];
    in-out property <[StagedFile]> staged-files: [];

    callback toggle-expanded();
    callback select-peer(int);
    callback send-files();
    callback clear-staged();

    // Outer notch container
    Rectangle {
        width: 100%;
        height: 100%;
        background: #0E0E14; // Obsidian Glass
        border-radius: 14px;
        border-width: 1px;
        border-color: #FFFFFF24;

        VerticalLayout {
            padding: 16px;
            spacing: 14px;

            // Header: Peer selector + Microdots
            HorizontalLayout {
                alignment: space-between;
                height: 32px;

                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 8px;
                        background: #181822;
                        border-width: 1px;
                        border-color: #FFFFFF26;

                        Text {
                            text: "📱";
                            font-size: 15px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;

                        Text {
                            text: root.active-peer-name;
                            color: #FFFFFFF5;
                            font-size: 13px;
                            font-weight: 700;
                        }

                        // Nusa-style microdots indicators
                        HorizontalLayout {
                            spacing: 5px;
                            alignment: start;

                            TouchArea {
                                width: 22px;
                                height: 10px;
                                clicked => {
                                    root.selected-peer-index = 0;
                                    root.active-peer-name = "Pixel 8 Pro (LocalSend)";
                                }
                                Rectangle {
                                    width: (root.selected-peer-index == 0) ? 18px : 6px;
                                    height: 5px;
                                    border-radius: 2.5px;
                                    background: (root.selected-peer-index == 0) ? #60A5FA : #FFFFFF40;
                                    animate width { duration: 160ms; }
                                    animate background { duration: 160ms; }
                                }
                            }

                            TouchArea {
                                width: 22px;
                                height: 10px;
                                clicked => {
                                    root.selected-peer-index = 1;
                                    root.active-peer-name = "iPad Air de Jose";
                                }
                                Rectangle {
                                    width: (root.selected-peer-index == 1) ? 18px : 6px;
                                    height: 5px;
                                    border-radius: 2.5px;
                                    background: (root.selected-peer-index == 1) ? #60A5FA : #FFFFFF40;
                                    animate width { duration: 160ms; }
                                    animate background { duration: 160ms; }
                                }
                            }

                            TouchArea {
                                width: 22px;
                                height: 10px;
                                clicked => {
                                    root.selected-peer-index = 2;
                                    root.active-peer-name = "Laptop ThinkPad";
                                }
                                Rectangle {
                                    width: (root.selected-peer-index == 2) ? 18px : 6px;
                                    height: 5px;
                                    border-radius: 2.5px;
                                    background: (root.selected-peer-index == 2) ? #60A5FA : #FFFFFF40;
                                    animate width { duration: 160ms; }
                                    animate background { duration: 160ms; }
                                }
                            }
                        }
                    }
                }

                // Status pill (Nusa style)
                Rectangle {
                    width: 75px;
                    height: 24px;
                    border-radius: 12px;
                    background: #10B98124;
                    border-width: 1px;
                    border-color: #10B98150;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 4px;

                        Rectangle {
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: #10B981;
                            y: 8px;
                        }

                        Text {
                            text: "En línea";
                            color: #34D399;
                            font-size: 11px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Middle: File Queue / Drop Zone
            Rectangle {
                height: 90px;
                background: #14141EF5;
                border-radius: 10px;
                border-width: 1px;
                border-color: #FFFFFF18;

                VerticalLayout {
                    alignment: center;
                    spacing: 5px;

                    Text {
                        text: "📁 Arrastra archivos aquí para enviar";
                        color: #FFFFFFEB;
                        font-size: 13px;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "Haz clic en los microdots arriba para cambiar de receptor";
                        color: #9CA3AF;
                        font-size: 11px;
                        horizontal-alignment: center;
                    }
                }
            }

            // Bottom action row: Send Button & Clear
            HorizontalLayout {
                alignment: space-between;
                height: 36px;

                TouchArea {
                    width: 90px;
                    clicked => { root.clear-staged(); }
                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 8px;
                        background: #FFFFFF12;
                        border-width: 1px;
                        border-color: #FFFFFF1C;
                        Text {
                            text: "Limpiar";
                            color: #D1D5DB;
                            font-size: 12px;
                            font-weight: 500;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                TouchArea {
                    width: 160px;
                    clicked => { root.send-files(); }
                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 8px;
                        background: #2563EB;
                        Text {
                            text: "Enviar archivo ➔";
                            color: #FFFFFF;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
